<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:eControl.Agent.UI.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
    mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
    x:Class="eControl.Agent.UI.Views.MainWindow"
    x:Name="Root"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="eControl Kiosk"
    WindowState="{Binding WindowState}"
    Height="{Binding WindowHeight}"
    Width="{Binding WindowWidth}"
    VerticalAlignment="{Binding VerticalAlignment}"
    SystemDecorations="None"
    Topmost="True"
    ShowInTaskbar="False"
    CanResize="False"
    Background="{Binding Background}"
    TransparencyLevelHint="Transparent, Mica, AcrylicBlur">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Background Layer (Only visible when locked or dashboard) -->
        <Border Background="#1A1A1A" Opacity="0.95" IsVisible="{Binding !IsSessionActive}" />

        <!-- Animated / Decorative Gradient (Fixed) -->
        <Border Opacity="0.3" IsVisible="{Binding !IsSessionActive}">
            <Border.Background>
                <RadialGradientBrush Center="50%,50%" GradientOrigin="50%,50%" RadiusX="100%"
                    RadiusY="100%">
                    <GradientStop Offset="0" Color="#4338CA" />
                    <GradientStop Offset="1" Color="Transparent" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- IDLE START SCREEN (Click to unlock) -->
        <!-- Visible when NOT LoggedIn AND Login Form CLOSED -->
        <Button
            Command="{Binding ShowLoginCommand}"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Background="Transparent">
            <Button.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!ShowLoginForm" />
                    <Binding Path="!IsLoggedIn" />
                </MultiBinding>
            </Button.IsVisible>
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </Button.Styles>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <!-- Clock/Date could go here -->
                <TextBlock Text="{Binding PcName}" FontSize="20" Foreground="#4B5563"
                    HorizontalAlignment="Center" />

                <TextBlock Text="Haz click o presiona cualquier tecla"
                    FontSize="18" FontWeight="Light" Foreground="#FFFFFF"
                    Opacity="0.7" HorizontalAlignment="Center"
                    Classes="blink" />
            </StackPanel>
        </Button>

        <!-- Login Card -->
        <!-- Visible when ShowLoginForm is TRUE AND NOT LoggedIn -->
        <Grid IsVisible="{Binding ShowLoginForm}">
            <!-- (Existing Login UI) -->
            <Border Width="450" Height="550"
                Background="#252525"
                CornerRadius="24"
                BoxShadow="0 20 50 0 #000000"
                VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Add key-down handler to reset timer if possible, or just rely on focus -->

                <StackPanel Margin="40" Spacing="25" VerticalAlignment="Center">
                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                        <TextBlock Text="eControl" FontSize="42" FontWeight="Black"
                            Foreground="White" HorizontalAlignment="Center" />
                        <TextBlock Text="KIOSK EDITION" FontSize="14" FontWeight="Bold"
                            Foreground="#6366F1" LetterSpacing="3" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding PcName}" FontSize="12" FontWeight="SemiBold"
                            Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,5,0,0" />
                    </StackPanel>

                    <Separator Height="1" Background="#333333" Margin="0,10" />

                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="USUARIO" FontSize="11" FontWeight="Bold"
                                Foreground="#9CA3AF" Margin="5,0" />
                            <TextBox Text="{Binding Username}"
                                Watermark="Ingrese su email o ID"
                                Height="50" CornerRadius="12"
                                Background="#1A1A1A" BorderThickness="1" BorderBrush="#333333"
                                Padding="15,12" VerticalContentAlignment="Center"
                                Foreground="White" CaretBrush="White" SelectionBrush="#6366F1">
                                <TextBox.Styles>
                                    <Style
                                        Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                        <Setter Property="Background" Value="#1A1A1A" />
                                        <Setter Property="BorderBrush" Value="#6366F1" />
                                    </Style>
                                    <Style
                                        Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                        <Setter Property="Background" Value="#1A1A1A" />
                                        <Setter Property="BorderBrush" Value="#4B5563" />
                                    </Style>
                                </TextBox.Styles>
                                <!-- Poor man's activity detector: Reset Timer on Text Change -->
                                <i:Interaction.Behaviors>
                                    <ia:EventTriggerBehavior EventName="TextChanged">
                                        <ia:CallMethodAction TargetObject="{Binding}"
                                            MethodName="ResetIdleTimer" />
                                    </ia:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="CONTRASEÑA" FontSize="11" FontWeight="Bold"
                                Foreground="#9CA3AF" Margin="5,0" />
                            <TextBox Text="{Binding Password}"
                                PasswordChar="*"
                                Watermark="••••••••"
                                Height="50" CornerRadius="12"
                                Background="#1A1A1A" BorderThickness="1" BorderBrush="#333333"
                                Padding="15,12" VerticalContentAlignment="Center"
                                Foreground="White" CaretBrush="White" SelectionBrush="#6366F1">
                                <TextBox.Styles>
                                    <Style
                                        Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                        <Setter Property="Background" Value="#1A1A1A" />
                                        <Setter Property="BorderBrush" Value="#6366F1" />
                                    </Style>
                                    <Style
                                        Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                        <Setter Property="Background" Value="#1A1A1A" />
                                        <Setter Property="BorderBrush" Value="#4B5563" />
                                    </Style>
                                </TextBox.Styles>
                                <i:Interaction.Behaviors>
                                    <ia:EventTriggerBehavior EventName="TextChanged">
                                        <ia:CallMethodAction TargetObject="{Binding}"
                                            MethodName="ResetIdleTimer" />
                                    </ia:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                        Foreground="#EF4444"
                        FontSize="13"
                        FontWeight="Medium"
                        HorizontalAlignment="Center"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Button Command="{Binding LoginCommand}"
                        HorizontalAlignment="Stretch" Height="55"
                        Background="#6366F1" Foreground="White"
                        CornerRadius="14" BorderThickness="0">
                        <Panel>
                            <TextBlock Text="INICIAR SESIÓN" FontWeight="Bold" FontSize="16"
                                IsVisible="{Binding !IsBusy}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True" Width="24" Height="24"
                                IsVisible="{Binding IsBusy}"
                                Background="Transparent" Foreground="White" />
                        </Panel>
                    </Button>

                    <TextBlock Text="© 2025 antigravity labs" FontSize="10" Foreground="#4B5563"
                        HorizontalAlignment="Center" Margin="0,20,0,0" />

                    <Button Command="{Binding EmergencyResetCommand}"
                        HorizontalAlignment="Center" Margin="0,10,0,0"
                        Background="Transparent" BorderThickness="0">
                        <TextBlock Text="⚠️ RESETEAR SISTEMA (EMERGENCIA)"
                            Foreground="#EF4444" Opacity="0.5" FontSize="9" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- User Dashboard (Authenticated but Locked) -->
        <Grid IsVisible="{Binding IsDashboardVisible}">
            <!-- Main Card -->
            <Border Width="1000" Height="700"
                Background="#1E1E1E"
                CornerRadius="30"
                BoxShadow="0 30 100 0 #000000"
                VerticalAlignment="Center" HorizontalAlignment="Center">

                <Grid RowDefinitions="Auto,*" Margin="40">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Bienvenido," FontSize="20" Foreground="#9CA3AF" />
                            <TextBlock Text="{Binding DisplayName}" FontSize="36" FontWeight="Black"
                                Foreground="White" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding LogoutCommand}"
                            Background="#252525" Foreground="#EF4444"
                            CornerRadius="12" Padding="15,10"
                            VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Cerrar Sesión" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Content -->
                    <Grid Grid.Row="1" ColumnDefinitions="300,*">
                        <!-- Left Panel: Balance & Actions -->
                        <StackPanel Grid.Column="0" Spacing="20" Margin="0,0,30,0">
                            <!-- Balance Card -->
                            <Border Background="#252525" CornerRadius="20" Padding="25">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="TU SALDO" FontSize="12" FontWeight="Bold"
                                        Foreground="#6B7280" />
                                    <!-- Use proper Binding for Balance if available in User Object,
                                    else static for now or need to fetch -->
                                    <TextBlock Text="{Binding UserBalance, StringFormat='{}{0:C}'}"
                                        FontSize="40" FontWeight="Bold"
                                        Foreground="#10B981" />
                                    <Button Content="Recargar" HorizontalAlignment="Stretch"
                                        Background="#10B981" Foreground="White" CornerRadius="8"
                                        Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Main Action -->
                            <Button Command="{Binding StartSessionCommand}"
                                HorizontalAlignment="Stretch" Height="80"
                                Background="#6366F1" Foreground="White"
                                CornerRadius="20" Margin="0,20,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="JUGAR AHORA" FontSize="20" FontWeight="Bold"
                                        HorizontalAlignment="Center" />
                                    <TextBlock Text="Modo Prepago" FontSize="12" Opacity="0.8"
                                        HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Error Message Display -->
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444"
                                TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10" />
                        </StackPanel>

                        <!-- Right Panel: Store -->
                        <Border Grid.Column="1" Background="#252525" CornerRadius="20" Padding="20">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="COMPRAR TIEMPO" FontWeight="Bold"
                                    Foreground="#FFFFFF" Margin="0,0,0,15" />

                                <ScrollViewer Grid.Row="1">
                                    <StackPanel Spacing="20">
                                        <!-- Rates Section -->
                                        <TextBlock Text="Tarifas" FontWeight="SemiBold"
                                            Foreground="#6366F1" FontSize="14" />
                                        <ItemsControl ItemsSource="{Binding Rates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Command="{Binding #Root.DataContext.PurchaseRateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        Background="#333333" CornerRadius="12"
                                                        Margin="0,0,0,10" Padding="15">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                    FontWeight="Bold"
                                                                    Foreground="White" FontSize="16" />
                                                                <TextBlock
                                                                    Text="{Binding Minutes, StringFormat='{}{0} Minutos'}"
                                                                    Foreground="#9CA3AF"
                                                                    FontSize="12" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding Price, StringFormat='{}{0:C}'}"
                                                                FontWeight="Bold"
                                                                Foreground="#10B981" FontSize="18"
                                                                VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Bundles Section -->
                                        <TextBlock Text="Paquetes (Ofertas)" FontWeight="SemiBold"
                                            Foreground="#F59E0B" FontSize="14" Margin="0,10,0,0" />
                                        <ItemsControl ItemsSource="{Binding Bundles}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Command="{Binding #Root.DataContext.PurchaseBundleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        Background="#333333" CornerRadius="12"
                                                        Margin="0,0,0,10" Padding="15">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}"
                                                                    FontWeight="Bold"
                                                                    Foreground="White" FontSize="16" />
                                                                <StackPanel Orientation="Horizontal"
                                                                    Spacing="10">
                                                                    <TextBlock
                                                                        Text="{Binding Minutes, StringFormat='{}{0} Minutos'}"
                                                                        Foreground="#9CA3AF"
                                                                        FontSize="12" />
                                                                    <Border Background="#F59E0B"
                                                                        CornerRadius="4"
                                                                        Padding="6,2"
                                                                        IsVisible="{Binding Coins, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                        <TextBlock
                                                                            Text="{Binding Coins, StringFormat='{}+ {0} Monedas'}"
                                                                            FontSize="10"
                                                                            FontWeight="Bold"
                                                                            Foreground="Black" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1"
                                                                Text="{Binding Price, StringFormat='{}{0:C}'}"
                                                                FontWeight="Bold"
                                                                Foreground="#10B981" FontSize="18"
                                                                VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <ProgressBar Grid.Row="1" IsIndeterminate="True"
                                    IsVisible="{Binding IsPurchaseLoading}"
                                    VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Floating Pill Toolbar (Session Active) -->
        <!-- Visible ONLY when IsPillVisible is TRUE -->
        <Grid IsVisible="{Binding IsPillVisible}" HorizontalAlignment="Center"
            VerticalAlignment="Top" Margin="0,15,0,0">
            <Border Background="#1F2937" CornerRadius="100" Padding="20,10"
                BoxShadow="0 4 15 0 #80000000">
                <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Foreground="#9CA3AF"
                            FontWeight="SemiBold"
                            FontSize="14" VerticalAlignment="Center" MaxWidth="120"
                            TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#10B981" />
                            <TextBlock Text="{Binding RemainingTime}" Foreground="White"
                                FontWeight="Bold"
                                FontFamily="Courier New" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Width="1" Height="20" Fill="#374151" />

                    <Button Command="{Binding LogoutCommand}"
                        Background="#EF4444" Foreground="White"
                        CornerRadius="20" Padding="15,5" FontSize="12" FontWeight="Bold"
                        Content="TERMINAR" BorderThickness="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Panel>
</Window>